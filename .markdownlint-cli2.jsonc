{
  // Rules switched off on purpose. Everything else uses markdownlint's defaults.
  "config": {
    "MD013": false, // line length: prose is written one paragraph per line
    "MD025": false, // the README uses H1s for its three parts
    "MD029": false, // README contents numbering continues across parts
    "MD033": { "allowed_elements": ["details", "summary", "br"] },
    "MD036": false, // bold lead-ins such as "Prove it" are intentional
    "MD041": false, // templates under .github don't start with a heading
    "MD060": false  // table pipe alignment
  },
  "ignores": ["node_modules/**"]
}

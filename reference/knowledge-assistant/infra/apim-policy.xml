<!--
  Policy for the model API. Order matters:
  1. Authenticate the caller with an Entra token. No subscription keys, no model keys.
  2. Apply a per-caller token budget (keyed on the caller's object ID).
  3. Emit token metrics to Application Insights, so cost is visible per caller.
  4. Call the model as the gateway's own managed identity. The caller never holds model access.
  Placeholders in __CAPS__ are replaced by resources.bicep.
-->
<policies>
  <inbound>
    <base />
    <validate-azure-ad-token tenant-id="__TENANT_ID__" output-token-variable-name="jwt" failed-validation-httpcode="401">
      <audiences>
        <audience>https://cognitiveservices.azure.com</audience>
      </audiences>
      <required-claims>
        <claim name="oid" match="any">__ALLOWED_OIDS__</claim>
      </required-claims>
    </validate-azure-ad-token>
    <llm-token-limit counter-key="@(((Jwt)context.Variables["jwt"]).Claims.GetValueOrDefault("oid", "unknown"))" tokens-per-minute="__TOKENS_PER_MINUTE__" estimate-prompt-tokens="false" remaining-tokens-header-name="x-remaining-tokens" />
    <llm-emit-token-metric namespace="harbourline">
      <dimension name="API ID" />
      <dimension name="Caller" value="@(((Jwt)context.Variables["jwt"]).Claims.GetValueOrDefault("oid", "unknown"))" />
    </llm-emit-token-metric>
    <set-backend-service backend-id="foundry-models" />
    <authentication-managed-identity resource="https://cognitiveservices.azure.com" />
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
